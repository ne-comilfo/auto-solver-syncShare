{
  "manifest_version": 3,
  "name": "SyncShare: заполнить по статистике",
  "description": "Добавляет кнопку для заполнения ответов по статистике SyncShare.",
  "version": "1.2.1",
  "minimum_chrome_version": "90",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Заполнить по статистике SyncShare",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["fill.js", "ui.js"],
    "run_at": "document_idle"
  }]
}
