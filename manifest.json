{
  "manifest_version": 3,
  "name": "SyncShare: заполнить по статистике",
  "description": "Добавляет кнопку для заполнения ответов по статистике SyncShare.",
  "version": "1.2.0",
  "minimum_chrome_version": "90",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_title": "Заполнить по статистике SyncShare"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["fill.js", "ui.js"],
    "run_at": "document_idle"
  }]
}
